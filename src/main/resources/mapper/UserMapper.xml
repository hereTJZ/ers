<mapper namespace="com.example.ers.dao.UserMapper">

    <sql id="sql1">
        <if test="nickName != null and nickName != ''">
            and customer_service.nick_name = #{nickName}
        </if>
        <if test="realName != null and realName != ''">
            and customer_service.real_name = #{realName}
        </if>
    </sql>

