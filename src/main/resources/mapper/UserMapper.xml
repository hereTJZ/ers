    <select id="login" resultType="User">
        select id,
               real_name,
               phone,
               email,
               role,
               school,
               faculty,
               grade,
               class,
               subject,
               gender,
               image_address,
               register_time
        from user
        where (phone = #{account} and password = #{password})
        or (email = #{account} and password = #{password})
    </select>

    <!--  insert、update、delete：返回影响行数n。（n>=1為成功，n为0时实际为插入失败） -->
    <insert id="register">
        insert into user(
            phone
            , email
            , password
            , real_name
            , role
            , register_time
        )
        values (
            #{phone}
            , #{email}
            , #{password}
            , #{realName}
            , #{role}
            , #{registerTime}
        )
    </insert>

    <!-- id自增长归位 -->


    <select id="findUserById" resultType="User">
        select id,
               real_name,
               phone,
               email,
               role,
               school,
               faculty,
               grade,
               class,
               subject,
               gender,
               image_address,
               register_time
        from user
        where id = #{id}
    </select>

    <select id="findUserByAccount" resultType="User">
        select id,
               real_name,
               phone,
               email,
               role,
               school,
               faculty,
               grade,
               class,
               subject,
               gender,
               image_address,
               register_time
        from user
        where (phone = #{account} or email = #{account})
    </select>

    <resultMap id="UserMap" type="User">
        <result column="id" property="id"/>
        <result column="" property=""/>
        <result column="" property=""/>
    </resultMap>

</mapper>